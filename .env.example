# Copie para .env e preencha. NUNCA commite o .env.

# --- Provedor do assistente: local | openai | anthropic ---
LLM_PROVIDER=openai

# OpenAI (modelo avaliado nos dois modos, temperatura 0)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (juiz da avaliação, outro fornecedor para reduzir viés)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Local (opcional; pensado para Colab com GPU T4)
LOCAL_MODEL=Qwen/Qwen2.5-3B-Instruct

# --- Recuperação ---
EMBEDDING_MODEL=intfloat/multilingual-e5-base
TOP_K=6
MIN_SCORE=
CHUNK_SIZE=800
CHUNK_OVERLAP=150
FUZZY_THRESHOLD=90

# --- Caminhos ---
PDF_DIR=data/pdfs
INDEX_DIR=data/index
