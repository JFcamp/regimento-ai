# Copie para .env e preencha. NUNCA commite o .env.

# --- Provedores (custo zero) ---
# Modelo avaliado e do chat (os dois modos, com e sem RAG): Google Gemini, plano gratuito.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Os nomes de modelo mudam e os limites do plano gratuito variam por modelo.
# Rode `python -m backend.listar_modelos` para ver o que a sua chave enxerga.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=12

# Juiz da avaliação (Etapa 5): Groq (a conta usada não tinha Llama grande; gpt-oss-120b) (outro fornecedor, para reduzir viés).
JUDGE_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_RPM=25

# Opcionais
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
LOCAL_MODEL=Qwen/Qwen2.5-3B-Instruct

TEMPERATURE=0
MAX_RETRIES=5

# --- Recuperação ---
EMBEDDING_MODEL=intfloat/multilingual-e5-base
TOP_K=6
CANDIDATOS=40
RRF_K=60
MAX_PAGINAS=3
PESO_PPC=0.85
# Vazio = usa o valor calibrado (ver docs/spec/design.md)
MIN_SCORE=
CHUNK_SIZE=800
CHUNK_OVERLAP=150
FUZZY_THRESHOLD=90
SUPORTE_THRESHOLD=45

# --- Caminhos ---
PDF_DIR=data/pdfs
INDEX_DIR=data/index
CACHE_SUGERIDAS=data/cache/sugeridas.json
